@using BTCPayServer.Plugins.OpenPatron.Services
@using BTCPayServer.Plugins.OpenPatron.ViewModels
@model BTCPayServer.Plugins.OpenPatron.ViewModels.OpenPatronPublicViewModel

@{
    Layout = "_LayoutSimple";
    ViewData["Title"] = Model.AppName;
    var theme = Model.Theme;
    var accent = theme.AccentColor;
    var radius = theme.BorderRadius;
    var spacing = theme.BlockSpacing;
}

@section PageHeadContent {
    <style>
        :root {
            --op-accent: @accent;
            --op-accent-10: @(accent)1a;
            --op-accent-18: @(accent)2e;
            --op-accent-dark: color-mix(in srgb, @accent 85%, #000);
            --op-border-radius: @radius;
            --op-block-spacing: @spacing;
        }

        body {
            background:
                radial-gradient(circle at top left, color-mix(in srgb, var(--op-accent) 14%, transparent), transparent 28%),
                radial-gradient(circle at top right, rgba(236, 72, 153, 0.10), transparent 24%),
                linear-gradient(180deg, #fcfcff 0%, #f7f8fc 100%);
        }

        .openpatron-page {
            max-width: 1120px;
            margin: 0 auto;
        }

        .mb-block {
            margin-bottom: var(--op-block-spacing);
        }

        .openpatron-hero,
        .openpatron-panel,
        .openpatron-plan-card {
            border: 1px solid rgba(15, 23, 42, 0.08);
            border-radius: var(--op-border-radius);
            background: rgba(255, 255, 255, 0.92);
            box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
            backdrop-filter: blur(12px);
        }

        .openpatron-hero {
            overflow: hidden;
            position: relative;
        }

        .openpatron-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background:
                radial-gradient(circle at top right, var(--op-accent-18), transparent 26%),
                linear-gradient(135deg, rgba(255, 255, 255, 0.94), rgba(248, 250, 252, 0.82));
            pointer-events: none;
        }

        .openpatron-hero > * {
            position: relative;
            z-index: 1;
        }

        .openpatron-profile-hero {
            text-align: center;
            padding: 3rem 2rem 2rem;
            border-radius: var(--op-border-radius);
            background:
                radial-gradient(circle at top, var(--op-accent-18), transparent 50%),
                rgba(255, 255, 255, 0.96);
            border: 1px solid rgba(15, 23, 42, 0.06);
            box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
        }

        .openpatron-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            border: 4px solid #fff;
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.12);
        }

        .openpatron-profile-name {
            font-size: clamp(1.75rem, 3vw, 2.75rem);
            font-weight: 800;
            letter-spacing: -.03em;
            line-height: 1.1;
        }

        .openpatron-badge {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            padding: .45rem .8rem;
            border-radius: 999px;
            background: var(--op-accent-10);
            color: var(--op-accent-dark);
            font-size: .875rem;
            font-weight: 700;
        }

        .openpatron-stat {
            display: inline-flex;
            align-items: center;
            gap: .45rem;
            padding: .65rem .9rem;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.78);
            border: 1px solid rgba(15, 23, 42, 0.08);
            color: #475569;
            font-size: .94rem;
            font-weight: 600;
        }

        .openpatron-kicker {
            font-size: .78rem;
            letter-spacing: .08em;
            text-transform: uppercase;
            font-weight: 700;
            color: var(--op-accent);
            margin-bottom: .75rem;
        }

        .openpatron-title {
            font-size: clamp(2.25rem, 4vw, 3.75rem);
            line-height: 1.05;
            letter-spacing: -.04em;
        }

        .openpatron-description {
            font-size: 1.02rem;
            line-height: 1.8;
            color: #475569;
        }

        .openpatron-description p { margin-bottom: 1rem; }
        .openpatron-description p:last-child { margin-bottom: 0; }
        .openpatron-description a { color: var(--op-accent); text-decoration: underline; }
        .openpatron-description ul, .openpatron-description ol { padding-left: 1.5rem; margin-bottom: 1rem; }
        .openpatron-description h1, .openpatron-description h2, .openpatron-description h3 { margin-top: 1.5rem; margin-bottom: .75rem; }
        .openpatron-description blockquote { border-left: 3px solid var(--op-accent-18); padding-left: 1rem; color: #64748b; margin: 1rem 0; }
        .openpatron-description code { background: rgba(15, 23, 42, 0.06); padding: .15rem .35rem; border-radius: .25rem; font-size: .9em; }
        .openpatron-description pre { background: rgba(15, 23, 42, 0.06); padding: 1rem; border-radius: .5rem; overflow-x: auto; margin-bottom: 1rem; }
        .openpatron-description pre code { background: none; padding: 0; }

        .openpatron-link-pill,
        .openpatron-amount-pill {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .45rem;
            border-radius: 999px;
            padding: .8rem 1rem;
            text-decoration: none;
            font-weight: 600;
        }

        .openpatron-link-pill {
            border: 1px solid rgba(15, 23, 42, 0.10);
            background: #fff;
            color: #0f172a;
        }

        .openpatron-link-pill:hover,
        .openpatron-link-pill:focus {
            background: #f8fafc;
            color: #0f172a;
        }

        .openpatron-amount-pill {
            border: 0;
            background: linear-gradient(135deg, #ffffff, color-mix(in srgb, var(--op-accent) 8%, #fff));
            box-shadow: inset 0 0 0 1px var(--op-accent-18);
            color: var(--op-accent-dark);
        }

        .openpatron-amount-pill:hover,
        .openpatron-amount-pill:focus {
            background: linear-gradient(135deg, color-mix(in srgb, var(--op-accent) 8%, #fff), color-mix(in srgb, var(--op-accent) 14%, #fff));
        }

        .openpatron-panel {
            padding: 1.5rem;
        }

        .openpatron-plan-card {
            height: 100%;
            padding: 1.5rem;
        }

        .openpatron-plan-price {
            font-size: 1.75rem;
            line-height: 1;
            letter-spacing: -.03em;
            color: #0f172a;
        }

        .openpatron-plan-meta {
            color: #64748b;
            font-weight: 500;
        }

        .openpatron-divider {
            height: 1px;
            background: linear-gradient(90deg, var(--op-accent-18), transparent);
            margin: 1.25rem 0;
        }

        .openpatron-sidebar-card {
            position: sticky;
            top: 2rem;
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 250, 252, 0.96));
        }

        .openpatron-sidebar-list {
            display: grid;
            gap: .75rem;
        }

        .openpatron-sidebar-item {
            display: flex;
            align-items: flex-start;
            gap: .75rem;
            color: #475569;
        }

        .openpatron-sidebar-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 2rem;
            height: 2rem;
            border-radius: 999px;
            background: var(--op-accent-10);
            color: var(--op-accent-dark);
            font-weight: 700;
            flex: 0 0 auto;
        }

        .openpatron-project-card {
            border: 1px solid rgba(15, 23, 42, 0.08);
            border-radius: var(--op-border-radius);
            background: rgba(255, 255, 255, 0.92);
            box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
            backdrop-filter: blur(12px);
            padding: 1.5rem;
            transition: box-shadow .2s;
        }

        .openpatron-project-card:hover {
            box-shadow: 0 24px 56px rgba(15, 23, 42, 0.12);
        }

        .openpatron-lang-badge {
            display: inline-flex;
            align-items: center;
            gap: .3rem;
            padding: .3rem .65rem;
            border-radius: 999px;
            background: var(--op-accent-10);
            color: var(--op-accent-dark);
            font-size: .8rem;
            font-weight: 600;
        }

        .openpatron-star-badge {
            display: inline-flex;
            align-items: center;
            gap: .3rem;
            padding: .3rem .65rem;
            border-radius: 999px;
            background: rgba(245, 158, 11, 0.10);
            color: #b45309;
            font-size: .8rem;
            font-weight: 600;
        }

        .openpatron-empty-state {
            border: 1px dashed rgba(148, 163, 184, 0.7);
            border-radius: 1rem;
            background: rgba(248, 250, 252, 0.75);
        }

        .openpatron-progress {
            height: 10px;
            border-radius: 5px;
            background: rgba(15, 23, 42, 0.06);
            overflow: hidden;
        }

        .openpatron-progress-bar {
            height: 100%;
            border-radius: 5px;
            background: linear-gradient(90deg, var(--op-accent), color-mix(in srgb, var(--op-accent) 70%, #ec4899));
            transition: width 0.6s ease;
        }

        .openpatron-social-pill {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            padding: .55rem .85rem;
            border-radius: 999px;
            border: 1px solid rgba(15, 23, 42, 0.10);
            background: #fff;
            color: #0f172a;
            text-decoration: none;
            font-weight: 600;
            font-size: .9rem;
        }

        .openpatron-social-pill:hover {
            background: #f8fafc;
            color: #0f172a;
        }

        .openpatron-wall-entry {
            display: flex;
            justify-content: space-between;
            padding: .5rem 0;
            border-bottom: 1px solid rgba(15, 23, 42, 0.05);
            font-size: .9rem;
            color: #475569;
        }
    </style>
}

<div class="py-5 openpatron-page">
    <div class="row g-4 align-items-start">
        <div class="col-12 col-lg-8">
            @foreach (var block in Model.PageLayout)
            {
                var partialPath = BlockRegistry.GetPartialViewPath(block.Type);
                if (partialPath != null)
                {
                    var ctx = new BlockRenderContext { Block = block, Page = Model };
                    var themeStyle = BlockSettingsHelper.BlockThemeStyle(block.Theme);
                    if (themeStyle != null)
                    {
                        <div style="@themeStyle">
                            <partial name="@partialPath" model="ctx" />
                        </div>
                    }
                    else
                    {
                        <partial name="@partialPath" model="ctx" />
                    }
                }
            }

            @if (Model.PageLayout.Count == 0)
            {
                <div class="openpatron-empty-state text-center py-5 px-4">
                    <p class="text-muted mb-0">This page is being set up.</p>
                </div>
            }
        </div>

        <div class="col-12 col-lg-4">
            <div class="openpatron-panel openpatron-sidebar-card">
                <div class="openpatron-kicker mb-2">Sponsor now</div>
                <h2 class="h3 fw-semibold mb-2">Sponsor this project</h2>
                <p class="text-muted mb-4">Support the maintainer in the way that makes the most sense for you.</p>

                @if (Model.SupportsOneTime)
                {
                    <form method="post" asp-action="Contribute" asp-route-appId="@Model.AppId" asp-route-area="OpenPatron" class="mb-4">
                        @Html.AntiForgeryToken()
                        <label for="customAmount" class="form-label fw-semibold">Custom one-time amount</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text">@Model.DefaultCurrency</span>
                            <input id="customAmount" name="amount" type="number" step="0.01" min="0.01" class="form-control" placeholder="25" />
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg w-100 mt-3" style="background: var(--op-accent); border-color: var(--op-accent);">Make a one-time payment</button>
                    </form>
                }

                @if (Model.SupportsSubscriptions && Model.Plans.Count > 0)
                {
                    <div class="mb-4 p-3 rounded-4" style="background: var(--op-accent-10); border: 1px solid var(--op-accent-18);">
                        <div class="fw-semibold text-dark mb-1">Want to back this work over time?</div>
                        <div class="text-muted small">Pick one of the sponsor tiers on this page to get started.</div>
                    </div>
                }

                @if (Model.SupportsSubscriptions || Model.SupportsOneTime)
                {
                    <div class="openpatron-divider"></div>

                    <div class="openpatron-sidebar-list">
                        @if (Model.SupportsSubscriptions)
                        {
                            <div class="openpatron-sidebar-item">
                                <span class="openpatron-sidebar-icon">↻</span>
                                <div>
                                    <div class="fw-semibold text-dark">Sponsor over time</div>
                                    <div class="small">Pick a sponsorship tier above.</div>
                                </div>
                            </div>
                        }
                        @if (Model.SupportsOneTime)
                        {
                            <div class="openpatron-sidebar-item">
                                <span class="openpatron-sidebar-icon">⚡</span>
                                <div>
                                    <div class="fw-semibold text-dark">Send a quick thank-you</div>
                                    <div class="small">Use a quick amount or enter your own.</div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
