@using BTCPayServer.Client
@using BTCPayServer.Plugins.OpenPatron.Models
@using BTCPayServer.Plugins.OpenPatron.Services
@model BTCPayServer.Plugins.OpenPatron.ViewModels.UpdateOpenPatronViewModel

@{
    ViewData["Title"] = "OpenPatron";
    var blockTypes = BlockRegistry.AllTypes;
}

<div class="sticky-header-setup"></div>
<div class="sticky-header">
    <h2>
        @ViewData["Title"]
        @if (Model.PageTypeConfirmed)
        {
            <span class="badge text-bg-secondary fs-6 ms-2 align-middle">@(Model.PageType == OpenPatronPageType.Personal ? "Personal" : "Project")</span>
        }
    </h2>
</div>

<form method="post" asp-action="Update" asp-route-appId="@Model.AppId" id="openpatronForm">
    <input asp-for="AppId" type="hidden" />
    <input asp-for="StoreId" type="hidden" />
    <input asp-for="OfferingId" type="hidden" />
    <input asp-for="PageTypeConfirmed" type="hidden" />
    <input asp-for="PageLayoutJson" type="hidden" id="pageLayoutJson" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @if (!Model.PageTypeConfirmed)
    {
        <div class="row justify-content-center mt-5">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="card">
                    <div class="card-body p-4">
                        <h3 class="h5 mb-2">Choose a starting template</h3>
                        <div class="form-text mb-4">You can customize the blocks freely afterward.</div>
                        <div class="d-flex flex-column gap-3">
                            <label class="d-flex align-items-start gap-3 border rounded-3 p-3 cursor-pointer page-type-option @(Model.PageType == OpenPatronPageType.Personal ? "border-primary border-2 bg-body-secondary" : "")" for="pageTypePersonal">
                                <input type="radio" asp-for="PageType" value="@((int)OpenPatronPageType.Personal)" id="pageTypePersonal" onchange="highlightPageType()" style="margin-top:4px;flex-shrink:0" />
                                <div>
                                    <span class="fw-semibold text-body">Personal</span>
                                    <div class="text-secondary small mt-1">Your profile, avatar, and a list of projects you maintain.</div>
                                </div>
                            </label>
                            <label class="d-flex align-items-start gap-3 border rounded-3 p-3 cursor-pointer page-type-option @(Model.PageType == OpenPatronPageType.Project ? "border-primary border-2 bg-body-secondary" : "")" for="pageTypeProject">
                                <input type="radio" asp-for="PageType" value="@((int)OpenPatronPageType.Project)" id="pageTypeProject" onchange="highlightPageType()" style="margin-top:4px;flex-shrink:0" />
                                <div>
                                    <span class="fw-semibold text-body">Project</span>
                                    <div class="text-secondary small mt-1">A single project — description, hero copy, and sponsorship tiers.</div>
                                </div>
                            </label>
                        </div>
                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary">Continue</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script>
            function highlightPageType() {
                document.querySelectorAll('.page-type-option').forEach(function (el) {
                    el.classList.remove('border-primary', 'border-2', 'bg-body-secondary');
                });
                var sel = document.querySelector('input[name="PageType"]:checked');
                if (sel) sel.closest('.page-type-option').classList.add('border-primary', 'border-2', 'bg-body-secondary');
            }
        </script>
    }
    else
    {
    <input asp-for="PageType" type="hidden" />

    <div class="row g-4">
        <div class="col-12 col-lg-8">

            <div class="form-group mb-3">
                <label asp-for="AppName" class="form-label"></label>
                <input asp-for="AppName" class="form-control" />
                <div class="form-text">Used in admin nav and invoice descriptions. Not shown to visitors.</div>
                <span asp-validation-for="AppName" class="text-danger"></span>
            </div>

            @* ── Block list with Visual / JSON toggle ── *@
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="h5 mb-0">Page blocks</h3>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small" id="blockCount"></span>
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-secondary active" id="modeVisualBtn">Visual</button>
                            <button type="button" class="btn btn-outline-secondary" id="modeJsonBtn">JSON</button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0" id="visualEditor">
                    <div id="blockList" class="list-group list-group-flush"></div>
                    <div id="emptyBlockState" class="text-center text-muted py-4 d-none">
                        No blocks yet. Add blocks from the panel on the right.
                    </div>
                </div>
                <div class="card-body d-none" id="jsonEditor">
                    <div class="form-text mb-2">Edit the raw block layout JSON. Switch back to Visual to see changes.</div>
                    <textarea id="jsonEditorTextarea" class="form-control font-monospace" rows="20" spellcheck="false" style="font-size:.85rem;tab-size:2;"></textarea>
                    <div id="jsonEditorError" class="text-danger small mt-1 d-none"></div>
                </div>
            </div>

            @* ── Global settings ── *@
            <div class="card mb-4">
                <div class="card-body">
                    <h3 class="h5 mb-3">Global settings</h3>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="SupportMode" class="form-label"></label>
                                <select asp-for="SupportMode" asp-items="Html.GetEnumSelectList<OpenPatronSupportMode>()" class="form-select"></select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="DefaultCurrency" class="form-label"></label>
                                <input asp-for="DefaultCurrency" class="form-control" />
                                <span asp-validation-for="DefaultCurrency" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ── Sidebar ── *@
        <div class="col-12 col-lg-4">

            <div class="card mb-3">
                <div class="card-header"><h3 class="h5 mb-0">Add blocks</h3></div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush" id="blockPicker">
                        @foreach (var (typeKey, typeInfo) in blockTypes)
                        {
                            <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center block-picker-item" data-block-type="@typeKey">
                                <div>
                                    <div class="fw-semibold">@typeInfo.DisplayName</div>
                                    <div class="text-muted small">@typeInfo.Description</div>
                                </div>
                                <span class="badge text-bg-primary rounded-pill">+</span>
                            </button>
                        }
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-body">
                    <h3 class="h5 mb-3">Theme</h3>
                    <div class="form-group mb-3">
                        <label asp-for="ThemeAccentColor" class="form-label"></label>
                        <div class="d-flex gap-2 align-items-center">
                            <input type="color" id="accentColorPicker" value="@(Model.ThemeAccentColor ?? "#6366f1")" class="form-control form-control-color" />
                            <input asp-for="ThemeAccentColor" class="form-control form-control-sm" placeholder="#6366f1" style="max-width:120px" />
                        </div>
                        <span asp-validation-for="ThemeAccentColor" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="ThemeBorderRadius" class="form-label"></label>
                        <select asp-for="ThemeBorderRadius" class="form-select">
                            <option value="0">Sharp (0)</option>
                            <option value="0.5rem">Subtle (0.5rem)</option>
                            <option value="1rem">Medium (1rem)</option>
                            <option value="1.5rem">Rounded (1.5rem)</option>
                            <option value="2rem">Very Rounded (2rem)</option>
                        </select>
                    </div>
                    <div class="form-group mb-0">
                        <label asp-for="ThemeBlockSpacing" class="form-label"></label>
                        <select asp-for="ThemeBlockSpacing" class="form-select">
                            <option value="0.5rem">Tight (0.5rem)</option>
                            <option value="1rem">Normal (1rem)</option>
                            <option value="1.5rem">Relaxed (1.5rem)</option>
                            <option value="2rem">Spacious (2rem)</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h3 class="h5 mb-3">Publishing</h3>
                    <div class="form-group mb-3">
                        <label asp-for="Visibility" class="form-label"></label>
                        <select asp-for="Visibility" asp-items="Html.GetEnumSelectList<OpenPatronVisibility>()" class="form-select"></select>
                    </div>
                    <div class="mb-3">
                        <div class="text-muted small">Public page</div>
                        <a href="@Model.PublicPageUrl" target="_blank" rel="noreferrer">@Model.PublicPageUrl</a>
                    </div>
                    <div class="mb-3">
                        <div class="text-muted small">Subscriptions offering</div>
                        @if (!string.IsNullOrWhiteSpace(Model.OfferingId))
                        {
                            <div class="small mb-2">Active plans: @Model.ActivePlanCount</div>
                            @if (!string.IsNullOrWhiteSpace(Model.ManageOfferingUrl))
                            {
                                <a class="btn btn-outline-secondary btn-sm w-100 mb-2" href="@Model.ManageOfferingUrl">Manage subscription plans</a>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.AddPlanUrl))
                            {
                                <a class="btn btn-outline-secondary btn-sm w-100" href="@Model.AddPlanUrl">Add subscription plan</a>
                            }
                        }
                        else
                        {
                            <div class="text-muted small">An offering will be created automatically when you save.</div>
                        }
                    </div>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary" id="saveBtn">Save changes</button>
                        <a class="btn btn-secondary" href="@Model.PublicPageUrl" target="_blank" rel="noreferrer">Preview page</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    }
</form>

@if (Model.PageTypeConfirmed)
{
    <div class="d-grid d-sm-flex flex-wrap gap-3 mt-3" permission="@Policies.CanModifyStoreSettings">
        <form method="post" asp-area="" asp-controller="UIApps" asp-action="ToggleArchive" asp-route-appId="@Model.AppId">
            <button type="submit" class="w-100 btn btn-outline-secondary" id="btn-archive-toggle">
                @(Model.Archived ? "Unarchive this app" : "Archive this app")
            </button>
        </form>
        <a id="DeleteApp" class="btn btn-outline-danger" asp-area="" asp-controller="UIApps" asp-action="DeleteApp" asp-route-appId="@Model.AppId"
           data-bs-toggle="modal" data-bs-target="#ConfirmModal"
           data-description="The app <strong>@Html.Encode(Model.AppName)</strong> and its settings will be permanently deleted."
           data-confirm-input="DELETE">Delete this app</a>
    </div>
    <partial name="_Confirm" model="@(new BTCPayServer.Abstractions.Models.ConfirmModel("Delete app", "This app will be removed from this store.", "Delete"))" permission="@Policies.CanModifyStoreSettings" />
}

<partial name="_ValidationScriptsPartial" />

@if (Model.PageTypeConfirmed)
{
<script src="~/vendor/vue-sortable/sortable.min.js"></script>
<script>
(function () {
    var BLOCK_TYPES = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
        blockTypes.ToDictionary(kv => kv.Key, kv => new { name = kv.Value.DisplayName, description = kv.Value.Description })));

    // ── Per-block-type form definitions ──
    // Each returns {html, read(formEl) -> settings}
    var BLOCK_FORMS = {
        'profile-hero': {
            fields: [
                { key: 'displayName', label: 'Display name', type: 'text', placeholder: 'Jane Doe' },
                { key: 'subtitle', label: 'Subtitle', type: 'text', placeholder: 'Open source maintainer' },
                { key: 'bio', label: 'Bio', type: 'textarea', placeholder: 'A few words about yourself…' },
                { key: 'gravatarEmail', label: 'Gravatar email', type: 'email', placeholder: 'you@example.com' },
                { key: 'gitHubUsername', label: 'GitHub username', type: 'text', placeholder: 'octocat' },
                { key: 'socialX', label: 'X (Twitter)', type: 'text', placeholder: 'handle' },
                { key: 'socialMastodon', label: 'Mastodon URL', type: 'url', placeholder: 'https://mastodon.social/@@user' },
                { key: 'socialNostr', label: 'Nostr (npub)', type: 'text', placeholder: 'npub1…' }
            ]
        },
        'project-hero': {
            fields: [
                { key: 'title', label: 'Headline', type: 'text', placeholder: 'Support My Work' },
                { key: 'subtitle', label: 'Subtitle', type: 'text', placeholder: 'Help fund open source development' },
                { key: 'displayName', label: 'Maintainer name', type: 'text', placeholder: 'Jane Doe' },
                { key: 'gravatarEmail', label: 'Gravatar email', type: 'email', placeholder: 'you@example.com' },
                { key: 'gitHubUsername', label: 'GitHub username', type: 'text', placeholder: 'octocat' },
                { key: 'socialX', label: 'X (Twitter)', type: 'text', placeholder: 'handle' },
                { key: 'socialMastodon', label: 'Mastodon URL', type: 'url', placeholder: 'https://mastodon.social/@@user' },
                { key: 'socialNostr', label: 'Nostr (npub)', type: 'text', placeholder: 'npub1…' }
            ]
        },
        'funding-progress': {
            fields: [
                { key: 'goal', label: 'Funding goal amount', type: 'number', placeholder: '1000' }
            ]
        },
        'description': {
            fields: [
                { key: 'heading', label: 'Section heading', type: 'text', placeholder: 'Why sponsor this work?' },
                { key: 'content', label: 'Content', type: 'textarea', placeholder: 'Tell visitors why they should sponsor…', rows: 8 }
            ]
        },
        'projects-grid': {
            custom: true
        },
        'subscription-tiers': {
            fields: [
                { key: 'heading', label: 'Section heading', type: 'text', placeholder: 'Choose a sponsorship tier' },
                { key: 'subtitle', label: 'Subtitle', type: 'text', placeholder: 'Pick the level that fits you best' }
            ]
        },
        'quick-support': {
            fields: [
                { key: 'heading', label: 'Section heading', type: 'text', placeholder: 'Send quick support' },
                { key: 'suggestedAmounts', label: 'Suggested amounts (comma-separated)', type: 'text', placeholder: '5, 15, 50' }
            ]
        },
        'sponsor-wall': {
            fields: [
                { key: 'heading', label: 'Section heading', type: 'text', placeholder: "Who's supporting this work" }
            ]
        }
    };

    var layoutInput = document.getElementById('pageLayoutJson');
    var blockListEl = document.getElementById('blockList');
    var emptyState = document.getElementById('emptyBlockState');
    var blockCountEl = document.getElementById('blockCount');
    var visualEditor = document.getElementById('visualEditor');
    var jsonEditor = document.getElementById('jsonEditor');
    var jsonTextarea = document.getElementById('jsonEditorTextarea');
    var jsonError = document.getElementById('jsonEditorError');
    var modeVisualBtn = document.getElementById('modeVisualBtn');
    var modeJsonBtn = document.getElementById('modeJsonBtn');

    var blocks = [];
    try { blocks = JSON.parse(layoutInput.value); } catch (_) { blocks = []; }
    if (!Array.isArray(blocks)) blocks = [];

    var expandedBlockId = null;
    var layoutExpandedBlockId = null;

    function generateId() { return Math.random().toString(36).substring(2, 14); }

    function esc(s) {
        var d = document.createElement('div');
        d.textContent = s || '';
        return d.innerHTML;
    }

    function val(settings, key) {
        if (!settings || settings[key] == null) return '';
        return settings[key];
    }

    // ── Render a block's config form HTML ──
    function renderBlockForm(block) {
        var def = BLOCK_FORMS[block.Type];
        if (!def) return '<div class="text-muted small p-3">No configuration for this block type.</div>';
        var s = block.Settings || {};

        if (def.custom && block.Type === 'projects-grid') {
            return renderProjectsForm(s);
        }

        var html = '<div class="p-3 bg-light border-top">';
        (def.fields || []).forEach(function (f) {
            var v = val(s, f.key);
            // suggestedAmounts is stored as array, display as comma-separated
            if (f.key === 'suggestedAmounts' && Array.isArray(v)) {
                v = v.join(', ');
            }
            var id = 'bf_' + block.Id + '_' + f.key;
            html += '<div class="form-group mb-2">';
            html += '<label class="form-label small" for="' + id + '">' + esc(f.label) + '</label>';
            if (f.type === 'textarea') {
                html += '<textarea class="form-control form-control-sm block-field" id="' + id + '" data-key="' + f.key + '" rows="' + (f.rows || 3) + '" placeholder="' + esc(f.placeholder) + '">' + esc(v) + '</textarea>';
            } else {
                html += '<input class="form-control form-control-sm block-field" id="' + id + '" data-key="' + f.key + '" type="' + (f.type || 'text') + '" placeholder="' + esc(f.placeholder) + '" value="' + esc(v) + '" />';
            }
            html += '</div>';
        });
        html += '</div>';
        return html;
    }

    function renderProjectsForm(s) {
        var projects = (s && s.projects) || [];
        var html = '<div class="p-3 bg-light border-top" data-projects-form>';
        projects.forEach(function (p, i) {
            html += '<div class="border rounded-3 p-2 mb-2 project-entry">' +
                '<div class="d-flex justify-content-between align-items-center mb-1">' +
                    '<strong class="small">Project ' + (i + 1) + '</strong>' +
                    '<button type="button" class="btn btn-sm btn-outline-danger py-0 px-1 project-entry-remove" data-pidx="' + i + '">&times;</button>' +
                '</div>' +
                '<div class="row g-1">' +
                    '<div class="col-4"><input class="form-control form-control-sm proj-field" data-pkey="name" placeholder="Name" value="' + esc(p.name || '') + '" /></div>' +
                    '<div class="col-4"><input class="form-control form-control-sm proj-field" data-pkey="url" placeholder="URL" value="' + esc(p.url || '') + '" /></div>' +
                    '<div class="col-4"><input class="form-control form-control-sm proj-field" data-pkey="description" placeholder="Description" value="' + esc(p.description || '') + '" /></div>' +
                '</div>' +
            '</div>';
        });
        html += '<button type="button" class="btn btn-sm btn-outline-secondary project-add-btn">+ Add project</button>';
        html += '</div>';
        return html;
    }

    // ── Collect form data back into block.Settings ──
    function collectBlockSettings(blockEl, block) {
        var def = BLOCK_FORMS[block.Type];
        if (!def) return;
        if (!block.Settings) block.Settings = {};

        if (def.custom && block.Type === 'projects-grid') {
            collectProjectsSettings(blockEl, block);
            return;
        }

        blockEl.querySelectorAll('.block-field').forEach(function (input) {
            var key = input.dataset.key;
            var value = input.value;
            if (key === 'suggestedAmounts') {
                block.Settings[key] = value.split(/[,;]/).map(function (s) { return parseFloat(s.trim()); }).filter(function (n) { return !isNaN(n) && n > 0; });
            } else if (key === 'goal') {
                block.Settings[key] = parseFloat(value) || 0;
            } else {
                block.Settings[key] = value;
            }
        });
    }

    function collectProjectsSettings(blockEl, block) {
        if (!block.Settings) block.Settings = {};
        var projects = [];
        blockEl.querySelectorAll('.project-entry').forEach(function (entry) {
            var p = {};
            entry.querySelectorAll('.proj-field').forEach(function (f) { p[f.dataset.pkey] = f.value; });
            if (p.name || p.url) projects.push(p);
        });
        block.Settings.projects = projects;
    }

    var sortableInstance = null;

    function initSortable() {
        if (sortableInstance) {
            sortableInstance.destroy();
            sortableInstance = null;
        }
        if (typeof Sortable !== 'undefined' && blocks.length > 1) {
            sortableInstance = Sortable.create(blockListEl, {
                handle: '.block-drag-handle',
                animation: 150,
                ghostClass: 'bg-primary-subtle',
                dragClass: 'shadow',
                onEnd: function (evt) {
                    var oldIndex = evt.oldIndex;
                    var newIndex = evt.newIndex;
                    if (oldIndex === newIndex) return;
                    collectAllOpenForms();
                    var moved = blocks.splice(oldIndex, 1)[0];
                    blocks.splice(newIndex, 0, moved);
                    renderBlockList();
                }
            });
        }
    }

    // ── Render the full visual block list ──
    function renderBlockList() {
        // Collect settings from any open forms first
        collectAllOpenForms();

        blockListEl.innerHTML = '';
        blocks.forEach(function (block, idx) {
            var info = BLOCK_TYPES[block.Type] || { name: block.Type, description: '' };
            var isExpanded = expandedBlockId === block.Id;
            var isFirst = idx === 0;
            var isLast = idx === blocks.length - 1;

            var item = document.createElement('div');
            item.className = 'list-group-item p-0 block-row';
            item.dataset.idx = idx;
            item.dataset.blockId = block.Id;

            var hasLayoutOverride = block.Layout && (block.Layout.AccentColor || block.Layout.BorderRadius);

            var headerHtml =
                '<div class="d-flex justify-content-between align-items-center p-2 block-header" style="cursor:pointer;" data-block-id="' + block.Id + '">' +
                    '<div class="d-flex align-items-center gap-2">' +
                        '<span class="block-drag-handle d-flex align-items-center text-muted px-1" style="cursor:grab;" title="Drag to reorder">&#9776;</span>' +
                        '<div>' +
                            '<div class="fw-semibold">' + esc(info.name) + ' <span class="text-muted fw-normal">' + (isExpanded ? '&#9660;' : '&#9654;') + '</span></div>' +
                            '<div class="text-muted small">' + esc(info.description) + '</div>' +
                        '</div>' +
                    '</div>' +
                    '<div class="d-flex align-items-center gap-1">' +
                        '<button type="button" class="btn btn-sm btn-link p-0 lh-1 block-layout-btn' + (hasLayoutOverride ? ' text-primary' : '') + '" data-block-id="' + block.Id + '" title="Style overrides">&#9998;</button>' +
                        '<button type="button" class="btn btn-sm btn-link p-0 lh-1 block-move-btn" data-dir="up" data-idx="' + idx + '"' + (isFirst ? ' disabled' : '') + ' title="Move up">&#9650;</button>' +
                        '<button type="button" class="btn btn-sm btn-link p-0 lh-1 block-move-btn" data-dir="down" data-idx="' + idx + '"' + (isLast ? ' disabled' : '') + ' title="Move down">&#9660;</button>' +
                        '<button type="button" class="btn btn-sm btn-outline-danger block-remove-btn" data-idx="' + idx + '">&times;</button>' +
                    '</div>' +
                '</div>';

            var layoutHtml = '';
            if (layoutExpandedBlockId === block.Id) {
                var lo = block.Layout || {};
                layoutHtml = '<div class="p-2 bg-body-tertiary border-top border-bottom">' +
                    '<div class="row g-2 align-items-end">' +
                        '<div class="col-auto">' +
                            '<label class="form-label small mb-0">Accent color</label>' +
                            '<div class="d-flex gap-1 align-items-center">' +
                                '<input type="color" class="form-control form-control-color form-control-sm layout-accent-picker" value="' + esc(lo.AccentColor || '#6366f1') + '" />' +
                                '<input type="text" class="form-control form-control-sm layout-field" data-lkey="AccentColor" value="' + esc(lo.AccentColor || '') + '" placeholder="inherit" style="max-width:100px" />' +
                            '</div>' +
                        '</div>' +
                        '<div class="col-auto">' +
                            '<label class="form-label small mb-0">Border radius</label>' +
                            '<select class="form-select form-select-sm layout-field" data-lkey="BorderRadius">' +
                                '<option value=""' + (!lo.BorderRadius ? ' selected' : '') + '>Inherit</option>' +
                                '<option value="0"' + (lo.BorderRadius === '0' ? ' selected' : '') + '>Sharp (0)</option>' +
                                '<option value="0.5rem"' + (lo.BorderRadius === '0.5rem' ? ' selected' : '') + '>Subtle (0.5rem)</option>' +
                                '<option value="1rem"' + (lo.BorderRadius === '1rem' ? ' selected' : '') + '>Medium (1rem)</option>' +
                                '<option value="1.5rem"' + (lo.BorderRadius === '1.5rem' ? ' selected' : '') + '>Rounded (1.5rem)</option>' +
                                '<option value="2rem"' + (lo.BorderRadius === '2rem' ? ' selected' : '') + '>Very Rounded (2rem)</option>' +
                            '</select>' +
                        '</div>' +
                        '<div class="col-auto">' +
                            '<button type="button" class="btn btn-sm btn-outline-secondary layout-clear-btn">Clear</button>' +
                        '</div>' +
                    '</div>' +
                '</div>';
            }

            var formHtml = isExpanded ? renderBlockForm(block) : '';
            item.innerHTML = headerHtml + layoutHtml + formHtml;
            blockListEl.appendChild(item);
        });

        emptyState.classList.toggle('d-none', blocks.length > 0);
        blockCountEl.textContent = blocks.length + ' block' + (blocks.length !== 1 ? 's' : '');
        syncToInput();
        initSortable();
    }

    function collectAllOpenForms() {
        if (!expandedBlockId) return;
        var openEl = blockListEl.querySelector('[data-block-id="' + expandedBlockId + '"]');
        var openBlock = blocks.find(function (b) { return b.Id === expandedBlockId; });
        if (openEl && openBlock) collectBlockSettings(openEl, openBlock);
    }

    function collectLayoutForm() {
        if (!layoutExpandedBlockId) return;
        var row = blockListEl.querySelector('[data-block-id="' + layoutExpandedBlockId + '"]');
        var block = blocks.find(function (b) { return b.Id === layoutExpandedBlockId; });
        if (!row || !block) return;
        var lo = {};
        row.querySelectorAll('.layout-field').forEach(function (f) {
            var v = f.value.trim();
            if (v) lo[f.dataset.lkey] = v;
        });
        block.Layout = (lo.AccentColor || lo.BorderRadius) ? lo : null;
    }

    function syncToInput() {
        layoutInput.value = JSON.stringify(blocks);
    }

    // ── Event: click on block list (remove, move, expand/collapse) ──
    blockListEl.addEventListener('click', function (e) {
        var removeBtn = e.target.closest('.block-remove-btn');
        if (removeBtn) {
            e.preventDefault(); e.stopPropagation();
            var idx = parseInt(removeBtn.dataset.idx, 10);
            if (blocks[idx] && blocks[idx].Id === expandedBlockId) expandedBlockId = null;
            blocks.splice(idx, 1);
            renderBlockList();
            return;
        }

        var moveBtn = e.target.closest('.block-move-btn');
        if (moveBtn) {
            e.preventDefault(); e.stopPropagation();
            var idx = parseInt(moveBtn.dataset.idx, 10);
            var dir = moveBtn.dataset.dir;
            if (dir === 'up' && idx > 0) { var t = blocks[idx-1]; blocks[idx-1] = blocks[idx]; blocks[idx] = t; if (expandedBlockId) {} }
            else if (dir === 'down' && idx < blocks.length - 1) { var t = blocks[idx+1]; blocks[idx+1] = blocks[idx]; blocks[idx] = t; }
            renderBlockList();
            return;
        }

        var layoutBtn = e.target.closest('.block-layout-btn');
        if (layoutBtn) {
            e.preventDefault(); e.stopPropagation();
            var bid = layoutBtn.dataset.blockId;
            collectLayoutForm();
            layoutExpandedBlockId = (layoutExpandedBlockId === bid) ? null : bid;
            renderBlockList();
            return;
        }

        var layoutClearBtn = e.target.closest('.layout-clear-btn');
        if (layoutClearBtn) {
            e.preventDefault(); e.stopPropagation();
            var row = layoutClearBtn.closest('.block-row');
            if (row) {
                var block = blocks.find(function (b) { return b.Id === row.dataset.blockId; });
                if (block) block.Layout = null;
            }
            renderBlockList();
            return;
        }

        var header = e.target.closest('.block-header');
        if (header && !e.target.closest('.block-drag-handle')) {
            e.preventDefault();
            var bid = header.dataset.blockId;
            collectAllOpenForms();
            expandedBlockId = (expandedBlockId === bid) ? null : bid;
            renderBlockList();
            return;
        }

        // Project entry remove
        var projRemove = e.target.closest('.project-entry-remove');
        if (projRemove) {
            e.preventDefault();
            var entry = projRemove.closest('.project-entry');
            if (entry) entry.remove();
            return;
        }

        // Project add
        var projAdd = e.target.closest('.project-add-btn');
        if (projAdd) {
            e.preventDefault();
            var form = projAdd.closest('[data-projects-form]');
            var newEntry = document.createElement('div');
            newEntry.className = 'border rounded-3 p-2 mb-2 project-entry';
            var count = form.querySelectorAll('.project-entry').length;
            newEntry.innerHTML =
                '<div class="d-flex justify-content-between align-items-center mb-1">' +
                    '<strong class="small">Project ' + (count + 1) + '</strong>' +
                    '<button type="button" class="btn btn-sm btn-outline-danger py-0 px-1 project-entry-remove">&times;</button>' +
                '</div>' +
                '<div class="row g-1">' +
                    '<div class="col-4"><input class="form-control form-control-sm proj-field" data-pkey="name" placeholder="Name" /></div>' +
                    '<div class="col-4"><input class="form-control form-control-sm proj-field" data-pkey="url" placeholder="URL" /></div>' +
                    '<div class="col-4"><input class="form-control form-control-sm proj-field" data-pkey="description" placeholder="Description" /></div>' +
                '</div>';
            form.insertBefore(newEntry, projAdd);
        }
    });

    // ── Layout accent color picker sync ──
    blockListEl.addEventListener('input', function (e) {
        var picker = e.target.closest('.layout-accent-picker');
        if (picker) {
            var textInput = picker.parentElement.querySelector('.layout-field[data-lkey="AccentColor"]');
            if (textInput) textInput.value = picker.value;
        }
        var textInput = e.target.closest('.layout-field[data-lkey="AccentColor"]');
        if (textInput && /^#[0-9a-fA-F]{6}$/.test(textInput.value)) {
            var picker2 = textInput.parentElement.querySelector('.layout-accent-picker');
            if (picker2) picker2.value = textInput.value;
        }
    });

    // ── GitHub auto-fill for project URL fields ──
    var ghUrlPattern = /^https?:\/\/github\.com\/([^\/]+)\/([^\/?#]+)\/?$/i;

    blockListEl.addEventListener('blur', function (e) {
        var input = e.target;
        if (!input.matches || !input.matches('.proj-field[data-pkey="url"]')) return;

        var url = input.value.trim();
        var match = ghUrlPattern.exec(url);
        if (!match) return;

        var owner = match[1];
        var repo = match[2].replace(/\.git$/i, '');
        var entry = input.closest('.project-entry');
        if (!entry) return;

        var nameField = entry.querySelector('.proj-field[data-pkey="name"]');
        var descField = entry.querySelector('.proj-field[data-pkey="description"]');

        if (nameField && nameField.value && descField && descField.value) return;

        input.classList.add('opacity-50');
        fetch('https://api.github.com/repos/' + encodeURIComponent(owner) + '/' + encodeURIComponent(repo), {
            headers: { 'Accept': 'application/vnd.github+json' }
        })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (data) {
            if (!data) return;
            if (nameField && !nameField.value) nameField.value = data.name || '';
            if (descField && !descField.value) descField.value = data.description || '';
        })
        .catch(function () {})
        .finally(function () { input.classList.remove('opacity-50'); });
    }, true);

    // ── Block picker ──
    document.getElementById('blockPicker').addEventListener('click', function (e) {
        e.preventDefault();
        var item = e.target.closest('.block-picker-item');
        if (!item) return;
        collectAllOpenForms();
        var type = item.dataset.blockType;
        var defaults = {};
        var def = BLOCK_FORMS[type];
        if (def && def.fields) {
            def.fields.forEach(function (f) {
                if (f.key === 'suggestedAmounts') defaults[f.key] = [];
                else if (f.key === 'goal') defaults[f.key] = 0;
                else defaults[f.key] = '';
            });
        }
        if (type === 'projects-grid') defaults = { projects: [] };
        var newBlock = { Id: generateId(), Type: type, Settings: defaults };
        blocks.push(newBlock);
        expandedBlockId = newBlock.Id;
        renderBlockList();
        blockListEl.lastElementChild.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });

    // ── Visual / JSON toggle ──
    var currentMode = 'visual';

    function getThemeFromForm() {
        return {
            AccentColor: document.getElementById('ThemeAccentColor').value || '#6366f1',
            BorderRadius: document.getElementById('ThemeBorderRadius').value || '1.5rem',
            BlockSpacing: document.getElementById('ThemeBlockSpacing').value || '1rem'
        };
    }

    function setThemeToForm(theme) {
        if (!theme) return;
        var accentInput = document.getElementById('ThemeAccentColor');
        var radiusInput = document.getElementById('ThemeBorderRadius');
        var spacingInput = document.getElementById('ThemeBlockSpacing');
        if (theme.AccentColor && accentInput) { accentInput.value = theme.AccentColor; }
        if (theme.BorderRadius && radiusInput) { radiusInput.value = theme.BorderRadius; }
        if (theme.BlockSpacing && spacingInput) { spacingInput.value = theme.BlockSpacing; }
        var pickerEl = document.getElementById('accentColorPicker');
        if (pickerEl && theme.AccentColor && /^#[0-9a-fA-F]{6}$/.test(theme.AccentColor)) {
            pickerEl.value = theme.AccentColor;
        }
    }

    function switchToVisual() {
        if (currentMode === 'json') {
            try {
                var parsed = JSON.parse(jsonTextarea.value.trim());
                if (parsed && !Array.isArray(parsed) && parsed.blocks) {
                    blocks = parsed.blocks;
                    setThemeToForm(parsed.theme);
                } else if (Array.isArray(parsed)) {
                    blocks = parsed;
                } else {
                    throw new Error('Must be an object with "blocks" array or a plain array');
                }
                jsonError.classList.add('d-none');
            } catch (err) {
                jsonError.textContent = 'Invalid JSON: ' + err.message;
                jsonError.classList.remove('d-none');
                return;
            }
        }
        currentMode = 'visual';
        expandedBlockId = null;
        layoutExpandedBlockId = null;
        visualEditor.classList.remove('d-none');
        jsonEditor.classList.add('d-none');
        modeVisualBtn.classList.add('active');
        modeJsonBtn.classList.remove('active');
        renderBlockList();
    }

    function switchToJson() {
        collectAllOpenForms();
        collectLayoutForm();
        currentMode = 'json';
        var payload = { theme: getThemeFromForm(), blocks: blocks };
        jsonTextarea.value = JSON.stringify(payload, null, 2);
        jsonError.classList.add('d-none');
        visualEditor.classList.add('d-none');
        jsonEditor.classList.remove('d-none');
        modeVisualBtn.classList.remove('active');
        modeJsonBtn.classList.add('active');
    }

    modeVisualBtn.addEventListener('click', function (e) { e.preventDefault(); switchToVisual(); });
    modeJsonBtn.addEventListener('click', function (e) { e.preventDefault(); switchToJson(); });

    jsonTextarea.addEventListener('input', function () {
        try {
            var parsed = JSON.parse(jsonTextarea.value);
            if (parsed && !Array.isArray(parsed) && parsed.blocks) {
                blocks = parsed.blocks;
                syncToInput();
                jsonError.classList.add('d-none');
            } else if (Array.isArray(parsed)) {
                blocks = parsed;
                syncToInput();
                jsonError.classList.add('d-none');
            }
        } catch (_) {}
    });

    document.getElementById('openpatronForm').addEventListener('submit', function () {
        collectAllOpenForms();
        collectLayoutForm();
        if (currentMode === 'json') {
            try {
                var p = JSON.parse(jsonTextarea.value);
                if (p && !Array.isArray(p) && p.blocks) { blocks = p.blocks; setThemeToForm(p.theme); }
                else if (Array.isArray(p)) { blocks = p; }
            } catch (_) {}
        }
        syncToInput();
    });

    renderBlockList();

    // ── Accent color picker sync ──
    var picker = document.getElementById('accentColorPicker');
    var colorInput = document.getElementById('ThemeAccentColor');
    if (picker && colorInput) {
        picker.addEventListener('input', function () { colorInput.value = picker.value; });
        colorInput.addEventListener('input', function () {
            if (/^#[0-9a-fA-F]{6}$/.test(colorInput.value)) picker.value = colorInput.value;
        });
    }
})();
</script>
}
