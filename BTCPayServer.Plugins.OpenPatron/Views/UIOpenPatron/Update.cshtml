@using BTCPayServer.Client
@using BTCPayServer.Plugins.OpenPatron.Models
@using BTCPayServer.Plugins.OpenPatron.Services
@model BTCPayServer.Plugins.OpenPatron.ViewModels.UpdateOpenPatronViewModel

@{
    ViewData["Title"] = "OpenPatron";
    var blockTypes = BlockRegistry.AllTypes;
}

<div class="sticky-header-setup"></div>
<div class="sticky-header">
    <h2>
        @ViewData["Title"]
        @if (Model.PageTypeConfirmed)
        {
            <span class="badge text-bg-secondary fs-6 ms-2 align-middle">@(Model.PageType == OpenPatronPageType.Personal ? "Personal" : "Project")</span>
        }
    </h2>
</div>

<form method="post" asp-action="Update" asp-route-appId="@Model.AppId" id="openpatronForm">
    <input asp-for="AppId" type="hidden" />
    <input asp-for="StoreId" type="hidden" />
    <input asp-for="OfferingId" type="hidden" />
    <input asp-for="PageTypeConfirmed" type="hidden" />
    <input asp-for="PageLayoutJson" type="hidden" id="pageLayoutJson" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @if (!Model.PageTypeConfirmed)
    {
        @* ── Initial setup: choose a starting template ── *@
        <div class="row justify-content-center mt-5">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="card">
                    <div class="card-body p-4">
                        <h3 class="h5 mb-2">Choose a starting template</h3>
                        <div class="form-text mb-4">You can customize the blocks freely afterward.</div>
                        <div class="d-flex flex-column gap-3">
                            <label class="d-flex align-items-start gap-3 border rounded-3 p-3 cursor-pointer page-type-option @(Model.PageType == OpenPatronPageType.Personal ? "border-primary bg-primary bg-opacity-10" : "")" for="pageTypePersonal">
                                <input type="radio" asp-for="PageType" value="@((int)OpenPatronPageType.Personal)" id="pageTypePersonal" onchange="highlightPageType()" style="margin-top:4px;flex-shrink:0" />
                                <div>
                                    <span class="fw-semibold">Personal</span>
                                    <div class="text-muted small mt-1">Your profile, avatar, and a list of projects you maintain.</div>
                                </div>
                            </label>
                            <label class="d-flex align-items-start gap-3 border rounded-3 p-3 cursor-pointer page-type-option @(Model.PageType == OpenPatronPageType.Project ? "border-primary bg-primary bg-opacity-10" : "")" for="pageTypeProject">
                                <input type="radio" asp-for="PageType" value="@((int)OpenPatronPageType.Project)" id="pageTypeProject" onchange="highlightPageType()" style="margin-top:4px;flex-shrink:0" />
                                <div>
                                    <span class="fw-semibold">Project</span>
                                    <div class="text-muted small mt-1">A single project — description, hero copy, and sponsorship tiers.</div>
                                </div>
                            </label>
                        </div>
                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary">Continue</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script>
            function highlightPageType() {
                document.querySelectorAll('.page-type-option').forEach(function (el) {
                    el.classList.remove('border-primary', 'bg-primary', 'bg-opacity-10');
                });
                var sel = document.querySelector('input[name="PageType"]:checked');
                if (sel) sel.closest('.page-type-option').classList.add('border-primary', 'bg-primary', 'bg-opacity-10');
            }
        </script>
    }
    else
    {
    @* ── Block-based editor ── *@
    <input asp-for="PageType" type="hidden" />

    <div class="row g-4">
        <div class="col-12 col-lg-8">

            @* ── Basic settings ── *@
            <div class="form-group mb-3">
                <label asp-for="AppName" class="form-label"></label>
                <input asp-for="AppName" class="form-control" />
                <div class="form-text">Used in admin nav and invoice descriptions. Not shown to visitors.</div>
                <span asp-validation-for="AppName" class="text-danger"></span>
            </div>

            @* ── Block list with Visual / JSON toggle ── *@
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="h5 mb-0">Page blocks</h3>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small" id="blockCount"></span>
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-secondary active" id="modeVisualBtn">Visual</button>
                            <button type="button" class="btn btn-outline-secondary" id="modeJsonBtn">JSON</button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0" id="visualEditor">
                    <div id="blockList" class="list-group list-group-flush">
                    </div>
                    <div id="emptyBlockState" class="text-center text-muted py-4 d-none">
                        No blocks yet. Add blocks from the panel on the right.
                    </div>
                </div>
                <div class="card-body d-none" id="jsonEditor">
                    <div class="form-text mb-2">Edit the raw block layout JSON. Switch back to Visual to see changes.</div>
                    <textarea id="jsonEditorTextarea" class="form-control font-monospace" rows="16" spellcheck="false" style="font-size:.85rem;tab-size:2;"></textarea>
                    <div id="jsonEditorError" class="text-danger small mt-1 d-none"></div>
                </div>
            </div>

            @* ── Page content settings ── *@
            <div class="card mb-4">
                <div class="card-body">
                    <h3 class="h5 mb-3">Page content</h3>

                    @* ── Profile ── *@
                    <div class="row g-3 align-items-start mb-3">
                        <div class="col-md-8">
                            <div class="form-group mb-3">
                                <label asp-for="DisplayName" class="form-label"></label>
                                <input asp-for="DisplayName" class="form-control" placeholder="e.g. Jane Doe" />
                                <span asp-validation-for="DisplayName" class="text-danger"></span>
                            </div>
                            <div class="form-group mb-3">
                                <label asp-for="GitHubUsername" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">@@</span>
                                    <input asp-for="GitHubUsername" class="form-control" placeholder="octocat" />
                                </div>
                                <span asp-validation-for="GitHubUsername" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4 text-center">
                            <div id="gravatarPreview" class="mb-2">
                                @if (!string.IsNullOrWhiteSpace(Model.GravatarEmail))
                                {
                                    <img src="@BTCPayServer.Plugins.OpenPatron.Controllers.UIOpenPatronController.ComputeGravatarUrl(Model.GravatarEmail)"
                                         alt="Gravatar" class="rounded-circle" width="96" height="96" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-secondary bg-opacity-25 d-inline-flex align-items-center justify-content-center" style="width:96px;height:96px;">
                                        <span class="text-muted">?</span>
                                    </div>
                                }
                            </div>
                            <div class="form-group">
                                <label asp-for="GravatarEmail" class="form-label small"></label>
                                <input asp-for="GravatarEmail" class="form-control form-control-sm" placeholder="you@example.com" />
                                <span asp-validation-for="GravatarEmail" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Bio" class="form-label"></label>
                        <textarea asp-for="Bio" class="form-control" rows="3" placeholder="A few words about yourself or your work…"></textarea>
                        <span asp-validation-for="Bio" class="text-danger"></span>
                    </div>

                    @* ── Social links ── *@
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="SocialX" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">@@</span>
                                    <input asp-for="SocialX" class="form-control" placeholder="handle" />
                                </div>
                                <span asp-validation-for="SocialX" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="SocialMastodon" class="form-label"></label>
                                <input asp-for="SocialMastodon" class="form-control" placeholder="https://mastodon.social/@@user" />
                                <span asp-validation-for="SocialMastodon" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="SocialNostr" class="form-label"></label>
                                <input asp-for="SocialNostr" class="form-control" placeholder="npub1…" />
                                <span asp-validation-for="SocialNostr" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    @* ── Hero & description ── *@
                    <div class="form-group mb-3">
                        <label asp-for="HeroTitle" class="form-label"></label>
                        <input asp-for="HeroTitle" class="form-control" />
                        <div class="form-text">Main heading on the public page. Defaults to the internal name when blank.</div>
                        <span asp-validation-for="HeroTitle" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="HeroSubtitle" class="form-label"></label>
                        <input asp-for="HeroSubtitle" class="form-control" />
                        <div class="form-text">Short line shown under the headline / your name.</div>
                        <span asp-validation-for="HeroSubtitle" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="8"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="SupportMode" class="form-label"></label>
                        <select asp-for="SupportMode" asp-items="Html.GetEnumSelectList<OpenPatronSupportMode>()" class="form-select"></select>
                        <div class="form-text">Choose whether the page accepts one-time payments, subscriptions, or both.</div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="PrimaryCallToAction" class="form-label"></label>
                        <input asp-for="PrimaryCallToAction" class="form-control" />
                        <span asp-validation-for="PrimaryCallToAction" class="text-danger"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label asp-for="DefaultCurrency" class="form-label"></label>
                                <input asp-for="DefaultCurrency" class="form-control" />
                                <span asp-validation-for="DefaultCurrency" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="form-group mb-3">
                                <label asp-for="SuggestedAmounts" class="form-label"></label>
                                <input asp-for="SuggestedAmounts" class="form-control" placeholder="5, 15, 50" />
                                <div class="form-text">Comma-separated suggested one-time amounts, using '.' for decimals.</div>
                                <span asp-validation-for="SuggestedAmounts" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* ── Projects ── *@
            <div id="projectsSection" class="card mb-4">
                <div class="card-body">
                    <h3 class="h5 mb-3">Projects you maintain</h3>
                    <div id="projectsList">
                        @for (var i = 0; i < Model.Projects.Count; i++)
                        {
                            <div class="border rounded-3 p-3 mb-3 project-row">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <strong class="project-row-title">Project @(i + 1)</strong>
                                    <button type="button" class="btn btn-sm btn-outline-danger project-remove-btn">Remove</button>
                                </div>
                                <input type="hidden" data-field="Language" name="Projects[@i].Language" value="@Model.Projects[i].Language" />
                                <input type="hidden" data-field="Stars" name="Projects[@i].Stars" value="@Model.Projects[i].Stars" />
                                <div class="row g-2">
                                    <div class="col-md-4">
                                        <input data-field="Name" name="Projects[@i].Name" value="@Model.Projects[i].Name" class="form-control form-control-sm" placeholder="Name" />
                                    </div>
                                    <div class="col-md-4">
                                        <input data-field="Url" name="Projects[@i].Url" value="@Model.Projects[i].Url" class="form-control form-control-sm" placeholder="URL" />
                                    </div>
                                    <div class="col-md-4">
                                        <input data-field="Description" name="Projects[@i].Description" value="@Model.Projects[i].Description" class="form-control form-control-sm" placeholder="Description" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="addProjectBtn">+ Add project manually</button>

                    @if (Model.AvailableGitHubRepos.Count > 0)
                    {
                        <div class="mt-4 p-3 rounded-3 bg-light border">
                            <h4 class="h6 mb-2">Suggested from GitHub</h4>
                            <div class="form-text mb-3">Select repos to add them to your project list, then save.</div>
                            @foreach (var repo in Model.AvailableGitHubRepos)
                            {
                                <div class="form-check mb-2">
                                    <input class="form-check-input gh-repo-check" type="checkbox"
                                           data-name="@repo.Name"
                                           data-url="@repo.HtmlUrl"
                                           data-desc="@(repo.Description ?? "")"
                                           data-lang="@(repo.Language ?? "")"
                                           data-stars="@repo.StargazersCount"
                                           id="gh-@repo.Name" />
                                    <label class="form-check-label" for="gh-@repo.Name">
                                        <strong>@repo.Name</strong>
                                        @if (repo.StargazersCount > 0)
                                        {
                                            <span class="badge text-bg-light">★ @repo.StargazersCount</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(repo.Language))
                                        {
                                            <span class="badge text-bg-info text-white">@repo.Language</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(repo.Description))
                                        {
                                            <div class="text-muted small">@repo.Description</div>
                                        }
                                    </label>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ── Sidebar ── *@
        <div class="col-12 col-lg-4">

            @* ── Add blocks panel ── *@
            <div class="card mb-3">
                <div class="card-header">
                    <h3 class="h5 mb-0">Add blocks</h3>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush" id="blockPicker">
                        @foreach (var (typeKey, typeInfo) in blockTypes)
                        {
                            <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center block-picker-item" data-block-type="@typeKey">
                                <div>
                                    <div class="fw-semibold">@typeInfo.DisplayName</div>
                                    <div class="text-muted small">@typeInfo.Description</div>
                                </div>
                                <span class="badge text-bg-primary rounded-pill">+</span>
                            </button>
                        }
                    </div>
                </div>
            </div>

            @* ── Theme settings ── *@
            <div class="card mb-3">
                <div class="card-body">
                    <h3 class="h5 mb-3">Theme</h3>
                    <div class="form-group mb-3">
                        <label asp-for="ThemeAccentColor" class="form-label"></label>
                        <div class="d-flex gap-2 align-items-center">
                            <input type="color" id="accentColorPicker" value="@(Model.ThemeAccentColor ?? "#6366f1")" class="form-control form-control-color" />
                            <input asp-for="ThemeAccentColor" class="form-control form-control-sm" placeholder="#6366f1" style="max-width:120px" />
                        </div>
                        <span asp-validation-for="ThemeAccentColor" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="ThemeBorderRadius" class="form-label"></label>
                        <select asp-for="ThemeBorderRadius" class="form-select">
                            <option value="0">Sharp (0)</option>
                            <option value="0.5rem">Subtle (0.5rem)</option>
                            <option value="1rem">Medium (1rem)</option>
                            <option value="1.5rem">Rounded (1.5rem)</option>
                            <option value="2rem">Very Rounded (2rem)</option>
                        </select>
                    </div>
                    <div class="form-group mb-0">
                        <label asp-for="ThemeBlockSpacing" class="form-label"></label>
                        <select asp-for="ThemeBlockSpacing" class="form-select">
                            <option value="0.5rem">Tight (0.5rem)</option>
                            <option value="1rem">Normal (1rem)</option>
                            <option value="1.5rem">Relaxed (1.5rem)</option>
                            <option value="2rem">Spacious (2rem)</option>
                        </select>
                    </div>
                </div>
            </div>

            @* ── Extras ── *@
            <div class="card mb-3">
                <div class="card-body">
                    <h3 class="h5 mb-3">Extras</h3>
                    <div class="form-group mb-3">
                        <label asp-for="FundingGoal" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">@Model.DefaultCurrency</span>
                            <input asp-for="FundingGoal" class="form-control" placeholder="1000" />
                        </div>
                        <div class="form-text">Set a goal and show progress on the public page. Leave empty to hide.</div>
                        <span asp-validation-for="FundingGoal" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <div class="form-check form-switch mt-2">
                            <input asp-for="ShowSponsorWall" class="form-check-input" />
                            <label asp-for="ShowSponsorWall" class="form-check-label"></label>
                        </div>
                        <div class="form-text">Show an anonymous list of contributions (date + amount, no names).</div>
                    </div>
                </div>
            </div>

            @* ── Publishing ── *@
            <div class="card">
                <div class="card-body">
                    <h3 class="h5 mb-3">Publishing</h3>

                    <div class="form-group mb-3">
                        <label asp-for="Visibility" class="form-label"></label>
                        <select asp-for="Visibility" asp-items="Html.GetEnumSelectList<OpenPatronVisibility>()" class="form-select"></select>
                        <div class="form-text">When set to Not published, the public URL returns 404 to visitors.</div>
                    </div>

                    <div class="mb-3">
                        <div class="text-muted small">Public page</div>
                        <a href="@Model.PublicPageUrl" target="_blank" rel="noreferrer">@Model.PublicPageUrl</a>
                    </div>

                    <div class="mb-3">
                        <div class="text-muted small">Subscriptions offering</div>
                        @if (!string.IsNullOrWhiteSpace(Model.OfferingId))
                        {
                            <div class="small mb-2">Offering ID: @Model.OfferingId</div>
                            <div class="small text-muted mb-2">Active plans: @Model.ActivePlanCount</div>
                            @if (!string.IsNullOrWhiteSpace(Model.ManageOfferingUrl))
                            {
                                <a class="btn btn-outline-secondary btn-sm w-100 mb-2" href="@Model.ManageOfferingUrl">Manage subscription plans</a>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.AddPlanUrl))
                            {
                                <a class="btn btn-outline-secondary btn-sm w-100" href="@Model.AddPlanUrl">Add subscription plan</a>
                            }
                        }
                        else
                        {
                            <div class="text-muted small">An offering will be created automatically when you save.</div>
                        }
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary" id="saveBtn">Save changes</button>
                        <a class="btn btn-secondary" href="@Model.PublicPageUrl" target="_blank" rel="noreferrer">Preview page</a>
                    </div>
                </div>
            </div>

            <div class="alert alert-info mt-3 mb-0">
                OpenPatron reuses BTCPay Subscriptions for recurring sponsorship. This page controls branding and the linked subscription offering.
            </div>
        </div>
    </div>
    } @* end else (PageTypeConfirmed) *@
</form>

@if (Model.PageTypeConfirmed)
{
    <div class="d-grid d-sm-flex flex-wrap gap-3 mt-3" permission="@Policies.CanModifyStoreSettings">
        <form method="post" asp-area="" asp-controller="UIApps" asp-action="ToggleArchive" asp-route-appId="@Model.AppId">
            <button type="submit" class="w-100 btn btn-outline-secondary" id="btn-archive-toggle">
                @(Model.Archived ? "Unarchive this app" : "Archive this app")
            </button>
        </form>
        <a id="DeleteApp" class="btn btn-outline-danger" asp-area="" asp-controller="UIApps" asp-action="DeleteApp" asp-route-appId="@Model.AppId"
           data-bs-toggle="modal" data-bs-target="#ConfirmModal"
           data-description="The app <strong>@Html.Encode(Model.AppName)</strong> and its settings will be permanently deleted."
           data-confirm-input="DELETE">Delete this app</a>
    </div>

    <partial name="_Confirm" model="@(new BTCPayServer.Abstractions.Models.ConfirmModel("Delete app", "This app will be removed from this store.", "Delete"))" permission="@Policies.CanModifyStoreSettings" />
}

<partial name="_ValidationScriptsPartial" />

@if (Model.PageTypeConfirmed)
{
<script>
(function () {
    // ── Block type catalog ──
    var BLOCK_TYPES = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
        blockTypes.ToDictionary(kv => kv.Key, kv => new { name = kv.Value.DisplayName, description = kv.Value.Description })));

    // ── DOM refs ──
    var layoutInput     = document.getElementById('pageLayoutJson');
    var blockListEl     = document.getElementById('blockList');
    var emptyState      = document.getElementById('emptyBlockState');
    var blockCountEl    = document.getElementById('blockCount');
    var visualEditor    = document.getElementById('visualEditor');
    var jsonEditor      = document.getElementById('jsonEditor');
    var jsonTextarea     = document.getElementById('jsonEditorTextarea');
    var jsonError        = document.getElementById('jsonEditorError');
    var modeVisualBtn   = document.getElementById('modeVisualBtn');
    var modeJsonBtn     = document.getElementById('modeJsonBtn');

    // ── Block data ──
    var blocks = [];
    try { blocks = JSON.parse(layoutInput.value); } catch (_) { blocks = []; }
    if (!Array.isArray(blocks)) blocks = [];

    function generateId() {
        return Math.random().toString(36).substring(2, 14);
    }

    function esc(s) {
        var d = document.createElement('div');
        d.textContent = s;
        return d.innerHTML;
    }

    // ── Render visual block list ──
    function renderBlockList() {
        blockListEl.innerHTML = '';
        blocks.forEach(function (block, idx) {
            var info = BLOCK_TYPES[block.Type] || { name: block.Type, description: '' };
            var item = document.createElement('div');
            item.className = 'list-group-item block-row';
            item.dataset.idx = idx;

            var isFirst = idx === 0;
            var isLast = idx === blocks.length - 1;

            item.innerHTML =
                '<div class="d-flex justify-content-between align-items-center">' +
                    '<div class="d-flex align-items-center gap-2">' +
                        '<div class="d-flex flex-column">' +
                            '<button type="button" class="btn btn-sm btn-link p-0 lh-1 block-move-btn" data-dir="up" data-idx="' + idx + '"' + (isFirst ? ' disabled' : '') + ' title="Move up">&#9650;</button>' +
                            '<button type="button" class="btn btn-sm btn-link p-0 lh-1 block-move-btn" data-dir="down" data-idx="' + idx + '"' + (isLast ? ' disabled' : '') + ' title="Move down">&#9660;</button>' +
                        '</div>' +
                        '<div>' +
                            '<div class="fw-semibold">' + esc(info.name) + '</div>' +
                            '<div class="text-muted small">' + esc(info.description) + '</div>' +
                        '</div>' +
                    '</div>' +
                    '<button type="button" class="btn btn-sm btn-outline-danger block-remove-btn" data-idx="' + idx + '">&times; Remove</button>' +
                '</div>';

            blockListEl.appendChild(item);
        });

        emptyState.classList.toggle('d-none', blocks.length > 0);
        blockCountEl.textContent = blocks.length + ' block' + (blocks.length !== 1 ? 's' : '');
        syncToInput();
    }

    function syncToInput() {
        layoutInput.value = JSON.stringify(blocks);
    }

    // ── Block list: remove ──
    blockListEl.addEventListener('click', function (e) {
        var removeBtn = e.target.closest('.block-remove-btn');
        if (removeBtn) {
            e.preventDefault();
            var idx = parseInt(removeBtn.dataset.idx, 10);
            blocks.splice(idx, 1);
            renderBlockList();
            return;
        }

        var moveBtn = e.target.closest('.block-move-btn');
        if (moveBtn) {
            e.preventDefault();
            var idx = parseInt(moveBtn.dataset.idx, 10);
            var dir = moveBtn.dataset.dir;
            if (dir === 'up' && idx > 0) {
                var tmp = blocks[idx - 1];
                blocks[idx - 1] = blocks[idx];
                blocks[idx] = tmp;
            } else if (dir === 'down' && idx < blocks.length - 1) {
                var tmp = blocks[idx + 1];
                blocks[idx + 1] = blocks[idx];
                blocks[idx] = tmp;
            }
            renderBlockList();
        }
    });

    // ── Block picker: add ──
    document.getElementById('blockPicker').addEventListener('click', function (e) {
        e.preventDefault();
        var item = e.target.closest('.block-picker-item');
        if (!item) return;
        var type = item.dataset.blockType;
        blocks.push({ Id: generateId(), Type: type, Settings: null });
        renderBlockList();
        blockListEl.lastElementChild.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });

    // ── Visual / JSON mode toggle ──
    var currentMode = 'visual';

    function switchToVisual() {
        if (currentMode === 'json') {
            var raw = jsonTextarea.value.trim();
            try {
                var parsed = JSON.parse(raw);
                if (!Array.isArray(parsed)) throw new Error('Must be an array');
                blocks = parsed;
                jsonError.classList.add('d-none');
            } catch (err) {
                jsonError.textContent = 'Invalid JSON: ' + err.message;
                jsonError.classList.remove('d-none');
                return;
            }
        }
        currentMode = 'visual';
        visualEditor.classList.remove('d-none');
        jsonEditor.classList.add('d-none');
        modeVisualBtn.classList.add('active');
        modeJsonBtn.classList.remove('active');
        renderBlockList();
    }

    function switchToJson() {
        currentMode = 'json';
        jsonTextarea.value = JSON.stringify(blocks, null, 2);
        jsonError.classList.add('d-none');
        visualEditor.classList.add('d-none');
        jsonEditor.classList.remove('d-none');
        modeVisualBtn.classList.remove('active');
        modeJsonBtn.classList.add('active');
    }

    modeVisualBtn.addEventListener('click', function (e) { e.preventDefault(); switchToVisual(); });
    modeJsonBtn.addEventListener('click', function (e) { e.preventDefault(); switchToJson(); });

    // Keep hidden input in sync when JSON textarea changes
    jsonTextarea.addEventListener('input', function () {
        try {
            var parsed = JSON.parse(jsonTextarea.value);
            if (Array.isArray(parsed)) {
                blocks = parsed;
                syncToInput();
                jsonError.classList.add('d-none');
            }
        } catch (_) { /* will validate on mode switch */ }
    });

    // Sync before form submit
    document.getElementById('openpatronForm').addEventListener('submit', function () {
        if (currentMode === 'json') {
            try {
                var parsed = JSON.parse(jsonTextarea.value);
                if (Array.isArray(parsed)) blocks = parsed;
            } catch (_) {}
        }
        syncToInput();
    });

    // ── Initial render ──
    renderBlockList();

    // ── Accent color picker sync ──
    var picker = document.getElementById('accentColorPicker');
    var colorInput = document.getElementById('ThemeAccentColor');
    if (picker && colorInput) {
        picker.addEventListener('input', function () { colorInput.value = picker.value; });
        colorInput.addEventListener('input', function () {
            if (/^#[0-9a-fA-F]{6}$/.test(colorInput.value)) picker.value = colorInput.value;
        });
    }

    // ── Project row management ──
    var projectList = document.getElementById('projectsList');
    if (projectList) {
        function renumberProjects() {
            projectList.querySelectorAll('.project-row').forEach(function (row, idx) {
                var title = row.querySelector('.project-row-title');
                if (title && !row.dataset.ghName) title.textContent = 'Project ' + (idx + 1);
                row.querySelectorAll('input[data-field]').forEach(function (inp) {
                    inp.name = 'Projects[' + idx + '].' + inp.dataset.field;
                });
            });
        }

        function buildProjectRow(opts) {
            opts = opts || {};
            var row = document.createElement('div');
            row.className = 'border rounded-3 p-3 mb-3 project-row';
            if (opts.ghName) row.dataset.ghName = opts.ghName;
            row.innerHTML =
                '<div class="d-flex justify-content-between align-items-start mb-2">' +
                    '<strong class="project-row-title"></strong>' +
                    '<button type="button" class="btn btn-sm btn-outline-danger project-remove-btn">Remove</button>' +
                '</div>' +
                '<input type="hidden" data-field="Language" />' +
                '<input type="hidden" data-field="Stars" />' +
                '<div class="row g-2">' +
                    '<div class="col-md-4"><input data-field="Name" class="form-control form-control-sm" placeholder="Name" /></div>' +
                    '<div class="col-md-4"><input data-field="Url" class="form-control form-control-sm" placeholder="URL" /></div>' +
                    '<div class="col-md-4"><input data-field="Description" class="form-control form-control-sm" placeholder="Description" /></div>' +
                '</div>';
            row.querySelector('.project-row-title').textContent = opts.ghName || 'Project';
            row.querySelector('[data-field="Language"]').value = opts.language || '';
            row.querySelector('[data-field="Stars"]').value = opts.stars || '';
            row.querySelector('[data-field="Name"]').value = opts.name || '';
            row.querySelector('[data-field="Url"]').value = opts.url || '';
            row.querySelector('[data-field="Description"]').value = opts.description || '';
            return row;
        }

        projectList.addEventListener('click', function (e) {
            if (!e.target.classList.contains('project-remove-btn')) return;
            var row = e.target.closest('.project-row');
            if (!row) return;
            if (row.dataset.ghName) {
                var cb = document.querySelector('.gh-repo-check[data-name="' + CSS.escape(row.dataset.ghName) + '"]');
                if (cb) cb.checked = false;
            }
            row.remove();
            renumberProjects();
        });

        var addBtn = document.getElementById('addProjectBtn');
        if (addBtn) {
            addBtn.addEventListener('click', function () {
                projectList.appendChild(buildProjectRow());
                renumberProjects();
            });
        }

        document.querySelectorAll('.gh-repo-check').forEach(function (cb) {
            cb.addEventListener('change', function () {
                if (this.checked) {
                    projectList.appendChild(buildProjectRow({
                        ghName: this.dataset.name,
                        name: this.dataset.name,
                        url: this.dataset.url,
                        description: this.dataset.desc,
                        language: this.dataset.lang,
                        stars: this.dataset.stars
                    }));
                } else {
                    var existing = projectList.querySelector('.project-row[data-gh-name="' + CSS.escape(this.dataset.name) + '"]');
                    if (existing) existing.remove();
                }
                renumberProjects();
            });
        });

        renumberProjects();
    }
})();
</script>
}
