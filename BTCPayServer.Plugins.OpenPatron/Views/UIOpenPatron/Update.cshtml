@using BTCPayServer.Client
@using BTCPayServer.Plugins.OpenPatron.Models
@using BTCPayServer.Plugins.OpenPatron.Services
@model BTCPayServer.Plugins.OpenPatron.ViewModels.UpdateOpenPatronViewModel

@{
    ViewData["Title"] = "OpenPatron";
    var blockTypes = BlockRegistry.AllTypes;
}

<div class="sticky-header-setup"></div>
<div class="sticky-header">
    <h2>
        @ViewData["Title"]
        @if (Model.PageTypeConfirmed)
        {
            <span class="badge text-bg-secondary fs-6 ms-2 align-middle">@(Model.PageType == OpenPatronPageType.Personal ? "Personal" : "Project")</span>
        }
    </h2>
</div>

<form method="post" asp-action="Update" asp-route-appId="@Model.AppId" id="openpatronForm">
    <input asp-for="AppId" type="hidden" />
    <input asp-for="StoreId" type="hidden" />
    <input asp-for="OfferingId" type="hidden" />
    <input asp-for="PageTypeConfirmed" type="hidden" />
    <input asp-for="SectionsJson" type="hidden" id="sectionsJson" />
    <input asp-for="PageLayoutPreset" type="hidden" id="pageLayoutPreset" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @if (!Model.PageTypeConfirmed)
    {
        <div class="row justify-content-center mt-5">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="card">
                    <div class="card-body p-4">
                        <h3 class="h5 mb-2">Choose a starting template</h3>
                        <div class="form-text mb-4">You can customize the blocks freely afterward.</div>
                        <div class="d-flex flex-column gap-3">
                            <label class="d-flex align-items-start gap-3 border rounded-3 p-3 cursor-pointer page-type-option @(Model.PageType == OpenPatronPageType.Personal ? "border-primary border-2 bg-body-secondary" : "")" for="pageTypePersonal">
                                <input type="radio" asp-for="PageType" value="@((int)OpenPatronPageType.Personal)" id="pageTypePersonal" onchange="highlightPageType()" style="margin-top:4px;flex-shrink:0" />
                                <div>
                                    <span class="fw-semibold text-body">Personal</span>
                                    <div class="text-secondary small mt-1">Your profile, avatar, and a list of projects you maintain.</div>
                                </div>
                            </label>
                            <label class="d-flex align-items-start gap-3 border rounded-3 p-3 cursor-pointer page-type-option @(Model.PageType == OpenPatronPageType.Project ? "border-primary border-2 bg-body-secondary" : "")" for="pageTypeProject">
                                <input type="radio" asp-for="PageType" value="@((int)OpenPatronPageType.Project)" id="pageTypeProject" onchange="highlightPageType()" style="margin-top:4px;flex-shrink:0" />
                                <div>
                                    <span class="fw-semibold text-body">Project</span>
                                    <div class="text-secondary small mt-1">A single project — description, hero copy, and sponsorship tiers.</div>
                                </div>
                            </label>
                        </div>
                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary">Continue</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script>
            function highlightPageType() {
                document.querySelectorAll('.page-type-option').forEach(function (el) {
                    el.classList.remove('border-primary', 'border-2', 'bg-body-secondary');
                });
                var sel = document.querySelector('input[name="PageType"]:checked');
                if (sel) sel.closest('.page-type-option').classList.add('border-primary', 'border-2', 'bg-body-secondary');
            }
        </script>
    }
    else
    {
    <input asp-for="PageType" type="hidden" />

    <div class="row g-4">
        <div class="col-12 col-lg-8">

            <div class="form-group mb-3">
                <label asp-for="AppName" class="form-label"></label>
                <input asp-for="AppName" class="form-control" />
                <div class="form-text">Used in admin nav and invoice descriptions. Not shown to visitors.</div>
                <span asp-validation-for="AppName" class="text-danger"></span>
            </div>

            @* ── Layout preset selector ── *@
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="h5 mb-0">Page layout</h3>
                </div>
                <div class="card-body">
                    <div class="row g-2" id="layoutPresetSelector"></div>
                </div>
            </div>

            @* ── Page blocks with Visual / JSON toggle ── *@
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="h5 mb-0">Page blocks</h3>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="swapColumnsBtn" title="Swap column contents">&#8644; Swap</button>
                        <span class="text-muted small" id="blockCount"></span>
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-secondary active" id="modeVisualBtn">Visual</button>
                            <button type="button" class="btn btn-outline-secondary" id="modeJsonBtn">JSON</button>
                        </div>
                    </div>
                </div>
                <div class="card-body" id="visualEditor">
                    <div id="sectionPreview" class="row g-3"></div>
                    <div id="emptyBlockState" class="text-center text-muted py-4 d-none">
                        No blocks yet. Add blocks from the panel on the right, or click <strong>+</strong> in a column.
                    </div>
                </div>
                <div class="card-body d-none" id="jsonEditor">
                    <div class="form-text mb-2">Advanced: edit your page layout directly as JSON. Changes here are applied when you switch back to <strong>Visual</strong>. Tip: paste the <a href="@Url.Action("Schema", "UIOpenPatron", new { area = OpenPatronPlugin.Area })" target="_blank" rel="noreferrer">JSON Schema</a> into an LLM to generate or tweak your layout.</div>
                    <textarea id="jsonEditorTextarea" class="form-control font-monospace" rows="20" spellcheck="false" style="font-size:.85rem;tab-size:2;"></textarea>
                    <div id="jsonEditorError" class="text-danger small mt-1 d-none"></div>
                </div>
            </div>

            @* ── Global settings ── *@
            <div class="card mb-4">
                <div class="card-body">
                    <h3 class="h5 mb-3">Global settings</h3>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="SupportMode" class="form-label"></label>
                                <select asp-for="SupportMode" asp-items="Html.GetEnumSelectList<OpenPatronSupportMode>()" class="form-select"></select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="DefaultCurrency" class="form-label"></label>
                                <input asp-for="DefaultCurrency" class="form-control" />
                                <span asp-validation-for="DefaultCurrency" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ── Sidebar ── *@
        <div class="col-12 col-lg-4">

            <div class="card mb-3" id="blockPickerCard">
                <div class="card-header"><h3 class="h5 mb-0">Add blocks</h3></div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush" id="blockPicker">
                        @foreach (var (typeKey, typeInfo) in blockTypes)
                        {
                            <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center block-picker-item" data-block-type="@typeKey">
                                <div>
                                    <div class="fw-semibold">@typeInfo.DisplayName</div>
                                    <div class="text-muted small">@typeInfo.Description</div>
                                </div>
                                <span class="badge text-bg-primary rounded-pill">+</span>
                            </button>
                        }
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-body">
                    <h3 class="h5 mb-3">Theme</h3>
                    <div class="form-group mb-3">
                        <label asp-for="ThemeAccentColor" class="form-label"></label>
                        <div class="d-flex gap-2 align-items-center">
                            <input type="color" id="accentColorPicker" value="@(Model.ThemeAccentColor ?? PageTheme.DefaultAccentColor)" class="form-control form-control-color" />
                            <input asp-for="ThemeAccentColor" class="form-control form-control-sm" placeholder="@PageTheme.DefaultAccentColor" style="max-width:120px" />
                        </div>
                        <span asp-validation-for="ThemeAccentColor" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="ThemeBorderRadius" class="form-label"></label>
                        <select asp-for="ThemeBorderRadius" class="form-select">
                            <option value="0">Sharp (0)</option>
                            <option value="0.5rem">Subtle (0.5rem)</option>
                            <option value="1rem">Medium (1rem)</option>
                            <option value="1.5rem">Rounded (1.5rem)</option>
                            <option value="2rem">Very Rounded (2rem)</option>
                        </select>
                    </div>
                    <div class="form-group mb-0">
                        <label asp-for="ThemeBlockSpacing" class="form-label"></label>
                        <select asp-for="ThemeBlockSpacing" class="form-select">
                            <option value="0.5rem">Tight (0.5rem)</option>
                            <option value="1rem">Normal (1rem)</option>
                            <option value="1.5rem">Relaxed (1.5rem)</option>
                            <option value="2rem">Spacious (2rem)</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-body">
                    <h3 class="h5 mb-3">Embed badge</h3>
                    <div class="mb-3">
                        <div class="text-muted small mb-2">Preview</div>
                        <a href="@Model.PublicPageUrl" target="_blank" rel="noreferrer">
                            <img src="@Model.BadgeUrl" alt="Sponsor" height="20" />
                        </a>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold mb-1">Markdown (GitHub README)</label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control font-monospace" readonly
                                   id="badgeMarkdown"
                                   value="[![Sponsor](@Model.BadgeUrl)](@Model.PublicPageUrl)" />
                            <button type="button" class="btn btn-outline-secondary" onclick="copySnippet('badgeMarkdown', this)">Copy</button>
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold mb-1">HTML</label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control font-monospace" readonly
                                   id="badgeHtml"
                                   value="&lt;a href=&quot;@Model.PublicPageUrl&quot;&gt;&lt;img src=&quot;@Model.BadgeUrl&quot; alt=&quot;Sponsor&quot; height=&quot;20&quot;&gt;&lt;/a&gt;" />
                            <button type="button" class="btn btn-outline-secondary" onclick="copySnippet('badgeHtml', this)">Copy</button>
                        </div>
                    </div>
                    <div class="form-text">Badge is only visible when the page is published.</div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h3 class="h5 mb-3">Publishing</h3>
                    <div class="form-group mb-3">
                        <label asp-for="Visibility" class="form-label"></label>
                        <select asp-for="Visibility" asp-items="Html.GetEnumSelectList<OpenPatronVisibility>()" class="form-select"></select>
                    </div>
                    <div class="mb-3">
                        <div class="text-muted small">Public page</div>
                        <a href="@Model.PublicPageUrl" target="_blank" rel="noreferrer">@Model.PublicPageUrl</a>
                    </div>
                    <div class="mb-3">
                        <div class="text-muted small">Subscriptions offering</div>
                        @if (!string.IsNullOrWhiteSpace(Model.OfferingId))
                        {
                            <div class="small mb-2">Active plans: @Model.ActivePlanCount</div>
                            @if (!string.IsNullOrWhiteSpace(Model.ManageOfferingUrl))
                            {
                                <a class="btn btn-outline-secondary btn-sm w-100 mb-2" href="@Model.ManageOfferingUrl">Manage subscription plans</a>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.AddPlanUrl))
                            {
                                <a class="btn btn-outline-secondary btn-sm w-100" href="@Model.AddPlanUrl">Add subscription plan</a>
                            }
                        }
                        else
                        {
                            <div class="text-muted small">An offering will be created automatically when you save.</div>
                        }
                    </div>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary" id="saveBtn">Save changes</button>
                        <a class="btn btn-secondary" href="@Model.PublicPageUrl" target="_blank" rel="noreferrer">Preview page</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── Block edit modal ── *@
    <div class="modal fade" id="blockEditModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="blockEditModalTitle">Edit block</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="blockEditModalBody"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="blockEditModalSave">Save</button>
                </div>
            </div>
        </div>
    </div>
    }
</form>

@if (Model.PageTypeConfirmed)
{
    <div class="d-grid d-sm-flex flex-wrap gap-3 mt-3" permission="@Policies.CanModifyStoreSettings">
        <form method="post" asp-area="" asp-controller="UIApps" asp-action="ToggleArchive" asp-route-appId="@Model.AppId">
            <button type="submit" class="w-100 btn btn-outline-secondary" id="btn-archive-toggle">
                @(Model.Archived ? "Unarchive this app" : "Archive this app")
            </button>
        </form>
        <a id="DeleteApp" class="btn btn-outline-danger" asp-area="" asp-controller="UIApps" asp-action="DeleteApp" asp-route-appId="@Model.AppId"
           data-bs-toggle="modal" data-bs-target="#ConfirmModal"
           data-description="The app <strong>@Html.Encode(Model.AppName)</strong> and its settings will be permanently deleted."
           data-confirm-input="DELETE">Delete this app</a>
    </div>
    <partial name="_Confirm" model="@(new BTCPayServer.Abstractions.Models.ConfirmModel("Delete app", "This app will be removed from this store.", "Delete"))" permission="@Policies.CanModifyStoreSettings" />
}

<partial name="_ValidationScriptsPartial" />

@if (Model.PageTypeConfirmed)
{
<script src="~/vendor/vue-sortable/sortable.min.js"></script>
<script>
function copySnippet(inputId, btn) {
    var input = document.getElementById(inputId);
    if (!input) return;
    navigator.clipboard.writeText(input.value).then(function () {
        var orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(function () { btn.textContent = orig; }, 1500);
    });
}
</script>
<script>
window.__openpatron = {
    defaultAccent: '@PageTheme.DefaultAccentColor',
    defaultBorderRadius: '@PageTheme.DefaultBorderRadius',
    defaultBlockSpacing: '@PageTheme.DefaultBlockSpacing',
    blockTypes: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
        blockTypes.ToDictionary(kv => kv.Key, kv => new { name = kv.Value.DisplayName, description = kv.Value.Description })))
};
</script>
<script src="/_content/BTCPayServer.Plugins.OpenPatron/js/openpatron-editor.js"></script>
}
