@model BTCPayServer.Plugins.OpenPatron.ViewModels.BlockRenderContext
@{
    var m = Model.Page;
    var hasProfile = !string.IsNullOrWhiteSpace(m.GravatarUrl) || !string.IsNullOrWhiteSpace(m.DisplayName) || !string.IsNullOrWhiteSpace(m.GitHubProfileUrl);
    var hasSocialLinks = !string.IsNullOrWhiteSpace(m.SocialX) || !string.IsNullOrWhiteSpace(m.SocialMastodon) || !string.IsNullOrWhiteSpace(m.SocialNostr);
}

<section class="openpatron-hero p-4 p-lg-5 mb-block" data-block-type="project-hero" data-block-id="@Model.Block.Id">
    <div class="row g-4 align-items-center">
        <div class="col-12 @(hasProfile ? "col-xl-8" : "")">
            <div class="openpatron-kicker">Support the work</div>
            <h1 class="openpatron-title fw-bold mb-3">@m.HeroTitle</h1>
            @if (!string.IsNullOrWhiteSpace(m.HeroSubtitle))
            {
                <p class="lead text-muted mb-4">@m.HeroSubtitle</p>
            }

            <div class="d-flex flex-wrap gap-2 mb-4">
                @if (m.SupportsSubscriptions)
                {
                    <div class="openpatron-stat">↻ Ongoing support</div>
                }
                @if (m.SupportsOneTime)
                {
                    <div class="openpatron-stat">⚡ Quick contribution</div>
                }
                @if (m.Plans.Count > 0)
                {
                    <div class="openpatron-stat">★ @m.Plans.Count ways to sponsor</div>
                }
            </div>

            @if (hasSocialLinks)
            {
                <div class="d-flex flex-wrap gap-2">
                    @if (!string.IsNullOrWhiteSpace(m.SocialX))
                    {
                        <a class="openpatron-social-pill" href="https://x.com/@m.SocialX" target="_blank" rel="noreferrer">𝕏 @@@m.SocialX</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(m.SocialMastodon))
                    {
                        <a class="openpatron-social-pill" href="@m.SocialMastodon" target="_blank" rel="noreferrer">🐘 Mastodon</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(m.SocialNostr))
                    {
                        <span class="openpatron-social-pill" title="@m.SocialNostr">⚡ Nostr</span>
                    }
                </div>
            }
        </div>

        @if (hasProfile)
        {
            <div class="col-12 col-xl-4">
                <div class="openpatron-panel h-100 text-center">
                    @if (!string.IsNullOrWhiteSpace(m.GravatarUrl))
                    {
                        <img src="@m.GravatarUrl" alt="@(m.DisplayName ?? "Avatar")" class="rounded-circle mb-3" width="96" height="96" />
                    }
                    @if (!string.IsNullOrWhiteSpace(m.DisplayName))
                    {
                        <div class="fw-semibold mb-1">@m.DisplayName</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(m.GitHubProfileUrl))
                    {
                        <a href="@m.GitHubProfileUrl" target="_blank" rel="noreferrer" class="small text-muted">GitHub ↗</a>
                    }
                </div>
            </div>
        }
    </div>
</section>
