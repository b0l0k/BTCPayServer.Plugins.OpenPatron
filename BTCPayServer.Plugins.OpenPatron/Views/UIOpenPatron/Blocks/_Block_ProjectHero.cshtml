@using BTCPayServer.Plugins.OpenPatron.Models
@using BTCPayServer.Plugins.OpenPatron.Services
@model BTCPayServer.Plugins.OpenPatron.ViewModels.BlockRenderContext
@{
    var settings = BlockSettingsHelper.GetTyped<ProjectHeroSettings>(Model.Block) ?? new();
    var avatarUrl = BlockSettingsHelper.AvatarUrl(Model.Block.Settings);
    var gitHubUrl = BlockSettingsHelper.GitHubProfileUrl(Model.Block.Settings);
    var title = !string.IsNullOrWhiteSpace(settings.Title) ? settings.Title : Model.Page.AppName;
    var subtitle = settings.Subtitle;
    var displayName = settings.DisplayName;
    var socialX = settings.SocialX;
    var socialMastodon = settings.SocialMastodon;
    var socialNostr = settings.SocialNostr;
    var hasSocial = !string.IsNullOrWhiteSpace(socialX) || !string.IsNullOrWhiteSpace(socialMastodon) || !string.IsNullOrWhiteSpace(socialNostr);
    var hasProfile = !string.IsNullOrWhiteSpace(avatarUrl) || !string.IsNullOrWhiteSpace(displayName) || !string.IsNullOrWhiteSpace(gitHubUrl);
}

<section class="openpatron-hero p-4 p-lg-5 mb-block" data-block-type="project-hero" data-block-id="@Model.Block.Id">
    <div class="row g-4 align-items-center">
        <div class="col-12 @(hasProfile ? "col-xl-8" : "")">
            <div class="openpatron-kicker">Support the work</div>
            <h1 class="openpatron-title fw-bold mb-3">@title</h1>
            @if (!string.IsNullOrWhiteSpace(subtitle))
            {
                <p class="lead text-muted mb-4">@subtitle</p>
            }

            <div class="d-flex flex-wrap gap-2 mb-4">
                @if (Model.Page.SupportsSubscriptions)
                {
                    <div class="openpatron-stat">↻ Ongoing support</div>
                }
                @if (Model.Page.SupportsOneTime)
                {
                    <div class="openpatron-stat">⚡ Quick contribution</div>
                }
                @if (Model.Page.Plans.Count > 0)
                {
                    <div class="openpatron-stat">★ @Model.Page.Plans.Count ways to sponsor</div>
                }
            </div>

            @if (hasSocial)
            {
                <div class="d-flex flex-wrap gap-2">
                    @if (!string.IsNullOrWhiteSpace(socialX))
                    {
                        <a class="openpatron-social-pill" href="https://x.com/@socialX" target="_blank" rel="noreferrer">𝕏 @@@socialX</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(socialMastodon))
                    {
                        <a class="openpatron-social-pill" href="@socialMastodon" target="_blank" rel="noreferrer">🐘 Mastodon</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(socialNostr))
                    {
                        <span class="openpatron-social-pill" title="@socialNostr">⚡ Nostr</span>
                    }
                </div>
            }
        </div>

        @if (hasProfile)
        {
            <div class="col-12 col-xl-4">
                <div class="openpatron-panel h-100 text-center">
                    @if (!string.IsNullOrWhiteSpace(avatarUrl))
                    {
                        <img src="@avatarUrl" alt="@(displayName ?? "Avatar")" class="rounded-circle mb-3" width="96" height="96" />
                    }
                    @if (!string.IsNullOrWhiteSpace(displayName))
                    {
                        <div class="fw-semibold mb-1">@displayName</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(gitHubUrl))
                    {
                        <a href="@gitHubUrl" target="_blank" rel="noreferrer" class="small text-muted">GitHub ↗</a>
                    }
                </div>
            </div>
        }
    </div>
</section>
