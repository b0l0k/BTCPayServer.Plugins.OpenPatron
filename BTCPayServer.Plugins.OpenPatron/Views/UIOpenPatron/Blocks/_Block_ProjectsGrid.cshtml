@using BTCPayServer.Plugins.OpenPatron.Models
@using BTCPayServer.Plugins.OpenPatron.Services
@using Newtonsoft.Json.Linq
@model BTCPayServer.Plugins.OpenPatron.ViewModels.BlockRenderContext
@{
    var settings = BlockSettingsHelper.GetTyped<ProjectsGridSettings>(Model.Block) ?? new();
    var projectTokens = BlockSettingsHelper.Arr(Model.Block.Settings, nameof(ProjectsGridSettings.Projects));
    var columnsPerRow = settings.ColumnsPerRow;
    if (columnsPerRow < 1 || columnsPerRow > 4) columnsPerRow = 2;
    var colClass = "col-12 col-md-" + (12 / columnsPerRow);
}

@if (projectTokens is { Count: > 0 })
{
    <section data-block-type="projects-grid" data-block-id="@Model.Block.Id">
        <div class="openpatron-kicker mb-2">Projects</div>
        <h2 class="h3 fw-semibold mb-3">Open source work</h2>
        <div class="row g-3">
            @foreach (var project in projectTokens.OfType<JObject>())
            {
                var name = BlockSettingsHelper.Str(project, "Name");
                var url = BlockSettingsHelper.Str(project, "Url");
                var desc = BlockSettingsHelper.Str(project, "Description");
                var lang = BlockSettingsHelper.Str(project, "Language");
                var stars = (int?)BlockSettingsHelper.Dec(project, "Stars");
                <div class="@colClass">
                    <a href="@url" target="_blank" rel="noreferrer" class="text-decoration-none">
                        <div class="openpatron-project-card d-flex flex-column h-100">
                            <h3 class="h5 fw-bold text-dark mb-2">@name</h3>
                            @if (!string.IsNullOrWhiteSpace(desc))
                            {
                                <p class="text-muted small flex-grow-1 mb-3">@desc</p>
                            }
                            <div class="d-flex gap-2 flex-wrap">
                                @if (!string.IsNullOrWhiteSpace(lang))
                                {
                                    <span class="openpatron-lang-badge">@lang</span>
                                }
                                @if (stars is > 0)
                                {
                                    <span class="openpatron-star-badge">★ @stars</span>
                                }
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </section>
}
