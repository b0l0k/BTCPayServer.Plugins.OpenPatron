@using BTCPayServer.Plugins.OpenPatron.Models
@using BTCPayServer.Plugins.OpenPatron.Services
@using BTCPayServer.Services
@model BTCPayServer.Plugins.OpenPatron.ViewModels.BlockRenderContext
@inject DisplayFormatter DisplayFormatter
@{
    var settings = BlockSettingsHelper.GetTyped<SponsorWallSettings>(Model.Block) ?? new();
    var heading = !string.IsNullOrWhiteSpace(settings.Heading) ? settings.Heading : "Who's supporting this work";
    var entries = Model.Page.SponsorWallEntries;
}

@if (entries.Count > 0)
{
    <section class="openpatron-panel" data-block-type="sponsor-wall" data-block-id="@Model.Block.Id">
        <div class="openpatron-kicker">Recent contributions</div>
        <h2 class="h4 fw-semibold mb-3">@heading</h2>
        <div>
            @foreach (var entry in entries)
            {
                <div class="openpatron-wall-entry">
                    <span>Anonymous</span>
                    <span class="fw-semibold">@DisplayFormatter.Currency(entry.Amount, entry.Currency, DisplayFormatter.CurrencyFormat.Symbol)</span>
                    <span class="text-muted small">@entry.Timestamp.ToString("MMM d, yyyy")</span>
                </div>
            }
        </div>
    </section>
}
