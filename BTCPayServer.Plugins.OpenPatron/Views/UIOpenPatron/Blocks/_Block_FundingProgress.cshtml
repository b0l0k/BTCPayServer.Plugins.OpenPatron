@using BTCPayServer.Plugins.OpenPatron.Models
@using BTCPayServer.Plugins.OpenPatron.Services
@model BTCPayServer.Plugins.OpenPatron.ViewModels.BlockRenderContext
@{
    var settings = BlockSettingsHelper.GetTyped<FundingProgressSettings>(Model.Block) ?? new();
    decimal? goal = settings.Goal > 0 ? settings.Goal : null;
    var currency = Model.Page.DefaultCurrency;
    var raised = Model.Page.AmountRaised;
    var pct = Model.Page.FundingPercentage;
    var barStyle = string.Equals(settings.ProgressBarStyle, "gradient", StringComparison.OrdinalIgnoreCase)
        ? "openpatron-progress-bar--gradient"
        : "openpatron-progress-bar--solid";
}

@if (goal is > 0)
{
    <section class="openpatron-panel" data-block-type="funding-progress" data-block-id="@Model.Block.Id">
        <div class="openpatron-kicker">Funding progress</div>
        <div class="d-flex justify-content-between align-items-end mb-2">
            <div>
                <span class="h4 fw-bold mb-0">@currency @raised.ToString("N2")</span>
                <span class="text-muted"> raised of @currency @goal.Value.ToString("N2") goal</span>
            </div>
            <span class="fw-semibold" style="color: var(--op-accent);">@pct%</span>
        </div>
        <div class="openpatron-progress">
            <div class="openpatron-progress-bar @barStyle" style="width: @pct%"></div>
        </div>
    </section>
}
