@using BTCPayServer.Plugins.OpenPatron.Models
@using BTCPayServer.Plugins.OpenPatron.Services
@model BTCPayServer.Plugins.OpenPatron.ViewModels.BlockRenderContext
@{
    var settings = BlockSettingsHelper.GetTyped<DescriptionSettings>(Model.Block) ?? new();
    var heading = !string.IsNullOrWhiteSpace(settings.Heading) ? settings.Heading : "About";
    var content = settings.Content;
}

@if (!string.IsNullOrWhiteSpace(content))
{
    <section class="openpatron-panel mb-block" data-block-type="description" data-block-id="@Model.Block.Id">
        <div class="openpatron-kicker">About</div>
        <h2 class="h3 fw-semibold mb-3">@heading</h2>
        <div class="openpatron-description">@Html.Raw(BlockSettingsHelper.RenderMarkdownToHtml(content))</div>
    </section>
}
