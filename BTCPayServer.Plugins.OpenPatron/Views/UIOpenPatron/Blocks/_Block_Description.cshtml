@model BTCPayServer.Plugins.OpenPatron.ViewModels.BlockRenderContext
@{
    var m = Model.Page;
}

@if (!string.IsNullOrWhiteSpace(m.Description))
{
    <section class="openpatron-panel mb-block" data-block-type="description" data-block-id="@Model.Block.Id">
        <div class="openpatron-kicker">About</div>
        <h2 class="h3 fw-semibold mb-3">Why sponsor this work?</h2>
        <div class="openpatron-description">@m.Description</div>
    </section>
}
